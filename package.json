{
  "name": "video-gen",
  "version": "0.1.0",
  "description": "AI news script-to-video bot for Twitter and TikTok",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.{ts,tsx}\" --fix",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f video-gen",
    "wan:setup": "bash workers/wan/setup.sh",
    "wan:serve": "workers/wan/.venv/bin/python workers/wan/server.py --preload",
    "wan:health": "curl -sS http://127.0.0.1:7860/health",
    "wan:prompt": "bash scripts/wan-prompt.sh",
    "tts:setup": "bash workers/tts/setup.sh",
    "tts:kokoro:setup": "bash scripts/tts-kokoro-setup.sh",
    "tts:serve": "workers/tts/.venv/bin/python workers/tts/server.py",
    "tts:health": "curl -sS http://127.0.0.1:7861/health",
    "tts:scripts": "python3 scripts/tts-gen-scripts.py",
    "tts:scripts:long": "python3 scripts/tts-gen-long-scripts.py",
    "tts:scripts:focus": "python3 scripts/tts-gen-focus-scripts.py",
    "tts:record": "bash scripts/tts-record.sh",
    "tts:record-pack": "bash scripts/tts-record-pack.sh",
    "tts:pack-qa": "workers/tts/.venv/bin/python scripts/tts-pack-qa.py",
    "tts:test": "bash scripts/tts-test.sh",
    "voice:dev": "yarn --cwd web/voice-pack dev",
    "voice:build": "yarn --cwd web/voice-pack build",
    "email:test": "bash scripts/email-test.sh",
    "service:install": "bash scripts/macos/install-services.sh",
    "service:uninstall": "bash scripts/macos/uninstall-services.sh",
    "service:status": "bash scripts/macos/status-services.sh"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^5.0.0",
    "better-sqlite3": "^11.8.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cron": "3.5.0",
    "edge-tts-universal": "^1.4.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.20.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "twitter-api-v2": "^1.20.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
