<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zanshinai.video-gen.app</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/scripts/macos/run-video-gen.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__ROOT__/logs/macos/app.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/logs/macos/app.stderr.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/__USER__/.nvm/versions/node/v22.13.1/bin:/opt/homebrew/bin:/usr/local/bin:/Users/__USER__/.local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/__USER__</string>
  </dict>
</dict>
</plist>
