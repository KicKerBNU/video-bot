PORT=3000
NEWS_API_URL=https://tech-news-production-af46.up.railway.app/api/digest
NEWS_API_KEY=
EDGE_TTS_VOICE=en-US-GuyNeural
## TTS: edge (Railway / Docker / default) | local (Mac XTTS clone)
TTS_PROVIDER=edge
LOCAL_TTS_URL=http://127.0.0.1:7861
LOCAL_TTS_TIMEOUT_MS=600000
LOCAL_TTS_VOICE=everton
# Kokoro fallback when Microsoft Edge TTS is blocked
KOKORO_VOICE=am_michael
KOKORO_SPEED=1.0
## Image provider: wan | huggingface | kling | openverse
IMAGE_PROVIDER=wan
WAN_API_URL=http://127.0.0.1:7860
WAN_IMAGE_WIDTH=480
WAN_IMAGE_HEIGHT=832
WAN_STEPS=30
WAN_GUIDANCE_SCALE=5
WAN_TIMEOUT_MS=600000
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_IMAGE_WIDTH=768
HF_IMAGE_HEIGHT=1344
KLING_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_BASE_URL=https://api.klingai.com
KLING_IMAGE_MODEL=kling-v1-5
KLING_IMAGE_RESOLUTION=1k
## Twitter / X — OAuth 1.0a only (Keys and tokens → OAuth 1.0a)
## Ignore Client ID / Client Secret (OAuth 2.0) for this bot.
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
## 08:01 in this machine's local timezone (override with CRON_TIMEZONE if needed)
CRON_SCHEDULE="1 8 * * *"
CRON_TIMEZONE=
BRAND_NAME=ZanshinAI
CLOSING_LINE=That's all for today's news on Zanshin A-I.
SKIP_PUBLISH=false
## Resend — email video.mp4 after each daily generation (independent of SKIP_PUBLISH)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ZanshinAI <onboarding@resend.dev>
## Comma-separated recipients. onboarding@resend.dev can only send to your Resend signup email until a domain is verified.
RESEND_TO_EMAIL=
SKIP_EMAIL=false
## Daily cron: retry until today's digest posts (default: 10 attempts, every 10 min)
PIPELINE_RETRY_ATTEMPTS=10
PIPELINE_RETRY_DELAY_MS=600000
## Reuse existing segment stills (faster local re-renders).
REUSE_IMAGES=false
